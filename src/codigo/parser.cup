package codigo;
import java_cup.runtime.Symbol;
import java.util.*;


/* código del parser */
parser code {:
    public static final int EXPECTED_CONFLICTS = 1;
    private java.util.List<String> erroresSintacticos = new java.util.ArrayList<>();
    public java.util.List<String> getErroresSintacticos() { return erroresSintacticos; }
    private boolean suppressBeginAfterMissingSemi = false;
    private boolean inVarGlobalsContext = false;

    private PilaSemantica pila = new PilaSemantica();
    private TablaSimbolos tabla = new TablaSimbolos();
    private Codigo codigo = new Codigo();

    private java.util.List<String> erroresSemanticos = new java.util.ArrayList<>();
    public java.util.List<String> getErroresSemanticos() { return erroresSemanticos; }

    private int ultimaLineaError = -1; // para evitar cascada
    //private int ultimaColumnaError = -1; 

    private String tok(Symbol s){
        if (s == null) return "<EOF>";
        // Detecta EOF por el símbolo, que es lo más confiable
        try {
            if (s.sym == sym.EOF) return "<EOF>";
        } catch (Exception ignore) {}

        // Si no hay valor o es vacío/espacios, trátalo como EOF
        if (s.value == null) return "<EOF>";
        String t = String.valueOf(s.value);
        if (t.trim().isEmpty()) return "<EOF>";
        return t;
    }


    /** registrar error (se puede modificar o extender los casos de errores...)*/
    private void addErr(int line, int col, String msg){
        // Silencia todos los errores adicionales en la misma línea    //
        if (line == ultimaLineaError) return;
        ultimaLineaError = line;

        String out = String.format("[Línea %d, Col %d] ERROR SINTACTICO: %s", line, col, msg);
        erroresSintacticos.add(out);
        System.out.println(out);
    }

    public void addErrSemantico(int line, int col, String msg) {
        String out = String.format("[Línea %d, Col %d] ERROR SEMANTICO: %s", line, col, msg);
        erroresSemanticos.add(out);
        System.out.println(out);
    }
    @Override
    public void syntax_error(java_cup.runtime.Symbol s) {
        // Evitar cascada: si estamos en VAR globales y el lookahead es BEGIN, no reportar
        if (s != null && s.sym == sym.BEGIN && inVarGlobalsContext) {
            return;
        }
        // Tipos en declaración VAR -> probablemente faltó ':'
        if (s != null &&
            (s.sym == sym.INT || s.sym == sym.REAL ||
            s.sym == sym.STRING || s.sym == sym.CHAR)) {
            addErr(s.left, s.right, "Declaracion de variable: se esperaba ':' antes del tipo");
            return;
        }
        // Evitar cascada: no reportar BEGIN inmediatamente después del ';' faltante
        if (s != null && s.sym == sym.BEGIN && suppressBeginAfterMissingSemi) {
            suppressBeginAfterMissingSemi = false;
            return;
        }

        int linea = (s != null ? s.left  : -1);
        int col   = (s != null ? s.right : -1);

        String mensaje;
        if (s == null || s.sym == sym.EOF) {
            mensaje = "Fin de archivo inesperado. ¿Falta el bloque principal BEGIN...END?";
        } else if (s.sym == sym.RPAREN) {
            mensaje = "Paréntesis de cierre ')' inesperado. ¿Falta un parámetro o expresión?";
        } else if (s.sym == sym.BEGIN) {
            mensaje = "'BEGIN' inesperado. ¿Falta cerrar una estructura anterior o falta ';'?";
        } else if (s.sym == sym.SEMI) {
            mensaje = "Punto y coma ';' inesperado. ¿Falta una sentencia o declaración?";
        } else if (s.sym == sym.END) {
            mensaje = "'END' inesperado. ¿Falta un 'BEGIN' correspondiente?";
        } else if (s.sym == sym.ELSE) {
            mensaje = "'ELSE' inesperado. ¿Falta un 'IF ... THEN' antes?";
        } else if (s.sym == sym.THEN) {
            mensaje = "'THEN' inesperado. ¿Falta la condición después de 'IF'?";
        } else if (s.sym == sym.DO) {
            mensaje = "'DO' inesperado. ¿Falta la condición después de 'WHILE' o expresión en 'FOR ... TO'?";
        } else if (s.sym == sym.COLON) {
            mensaje = "Dos puntos ':' inesperados. ¿En declaración de variables o tipo de retorno?";
        } else if (s.sym == sym.COMMA) {
            mensaje = "Coma ',' inesperada. ¿En lista de parámetros o declaración de variables?";
        } else if (s.sym == sym.ASSIGN) { // :=
            mensaje = "Asignación ':=' inesperada. ¿Falta el identificador a la izquierda?";
        } else if (s.sym == sym.LPAREN) {
            mensaje = "Paréntesis de apertura '(' inesperado. ¿En llamada a función o expresión?";
        } else {
            String tokenStr = tok(s);
            mensaje = "Token inesperado '" + tokenStr + "'";
        }

        addErr(linea, col, mensaje);

        if (s != null) {
            switch (s.sym) {
                case sym.SEMI:
                case sym.END:
                case sym.RPAREN:
                    ultimaLineaError = -1;
                    break;
            }
        }
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) {
        int linea = (s.left > 0) ? s.left : -1;
        int col   = (s.right > 0) ? s.right : -1;

        String tokenStr = tok(s);
        
        addErr(linea, col,
            "Error sintáctico no recuperable cerca de '" + tokenStr + "'. " +
            "El parser no puede continuar desde este punto. " +
            "Revise la sintaxis de las estructuras anteriores.");
    }
:};

action code {: // Código para el analisis semántico
:};

/* DECLARACIÓN DE TOKENS (terminales) */

/* Palabras reservadas */
terminal ABSOLUTE, AND, ARRAY, BEGIN, CASE, CONST, CONSTRUCTOR, DESTRUCTOR,
         DIV, DO, DOWNTO, ELSE, END, EXTERNAL, FILE, FOR, FORWARD,
         FUNCTION, GOTO, IF, IMPLEMENTATION, IN, INLINE, INTERFACE,
         INTERRUPT, LABEL, MOD, NIL, NOT, OBJECT, OF, OR, PACKED, PRIVATE,
         PROCEDURE, PROGRAM, RECORD, REPEAT, SET, SHL, SHR, THEN, TO, TYPE,
         UNIT, UNTIL, USES, VAR, VIRTUAL, WHILE, WITH, WRITE, READ,
         INT, REAL, CHAR, STRING, RETURN;

/* Literales */
terminal String STRING_LIT;
terminal String CHAR_LIT;
terminal String REAL_LIT;
terminal String INT_LIT;

/* Operadores / símbolos simples */
terminal ASSIGN, SEMI, COMMA, LPAREN, RPAREN;
terminal EQ, NEQ, LE, GE, LT, GT;
terminal PLUS, MINUS, TIMES, SLASH, COLON;
terminal INC, DEC;
terminal DECLS_END;

/* Identificadores y error léxico */
terminal String ID;
terminal ERROR;


/*  NO TERMINALES  */
non terminal Object programa;
non terminal Object decls_globales_opt;
non terminal Object lista_decl_var;
non terminal Object decl_var;
non terminal java.util.List<String> lista_ids;
non terminal String tipo;
non terminal Object funcs_opt;
non terminal Object lista_func;
non terminal Object funcion;
non terminal Object params_formales_opt;
non terminal Object lista_params_formales;
non terminal Object param_formal;
non terminal Object bloque_func;
non terminal Object bloque_main;
non terminal Object bloque;
non terminal Object lista_sentencias;
non terminal Object sentencia;
non terminal Object asignacion;
non terminal Object llamada_funcion_stmt;
non terminal Object read_stmt;
non terminal Object write_stmt;
non terminal Object if_stmt;
non terminal Object while_stmt;
non terminal Object for_stmt;
non terminal Object parametros_llamada_opt;
non terminal Object lista_expresiones;
non terminal Registro expresion;      /* CAMBIAR de Object a Registro */
non terminal Registro condicion;      /* CAMBIAR de Object a Registro */
non terminal Registro factor;         /* CAMBIAR de Object a Registro */
non terminal Object decls_locales_opt;

/* PRECEDENCIAS  */
precedence left OR, AND;
precedence right NOT;
precedence nonassoc EQ, NEQ, LT, LE, GT, GE;
precedence left PLUS, MINUS, INC, DEC;
precedence left TIMES, SLASH, DIV, MOD;
precedence left DECLS_END;   /* marcador para forzar REDUCE al salir de VAR */

start with programa;

/* REGLAS DE LA GRAMÁTICA */

/*  Programa completo 

   PROGRAM Nombre
   [Globales]
   [Funciones]
   BEGIN
      ...sentencias...
   END
*/
programa
  ::= PROGRAM ID decls_globales_opt funcs_opt bloque_main
      {: RESULT = null;

          // print de la tabla de simbolos
          System.out.println("\n=== TABLA DE SIMBOLOS ===");
          try {
              // Acceder directamente a la tabla interna con reflexión
              java.lang.reflect.Field campo = tabla.getClass().getDeclaredField("tabla");
              campo.setAccessible(true);
              java.util.HashMap<String, String> mapa = (java.util.HashMap<String, String>) campo.get(tabla);
              
              // Imprimir cada entrada: id -> tipo
              for (java.util.Map.Entry<String, String> entrada : mapa.entrySet()) {
                  System.out.println(entrada.getKey() + " -> " + entrada.getValue());
              }
          } catch (Exception e) {
              System.out.println("Error: " + e.getMessage());
          }
          System.out.println("=== FIN TABLA ===\n");

          System.out.println("\n");
          if (erroresSemanticos.isEmpty()) {
              System.out.println("No se encontraron errores semánticos.");
          } else {
              System.out.println("ERRORES SEMÁNTICOS ENCONTRADOS: " + erroresSemanticos.size());
              // Los errores ya fueron impresos en addErrSemantico, este es el resumen
          }
          System.out.println(""); 
      :}
  | PROGRAM ID decls_globales_opt funcs_opt error
      {: 
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left, 
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right, 
               "FALTA EL BLOQUE PRINCIPAL. Todo programa debe tener: BEGIN ... END"); 
      :}
  | error
      {: 
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left, 
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right, 
               "El archivo debe iniciar con 'Program <id>' seguido del bloque principal BEGIN...END"); 
      :}
  ;


/*  Declaraciones globales 
   VAR
       nombre, apellido : STRING;
       contador : INT;
*/

/* Globales opcionales */
decls_globales_opt
  ::= VAR {:
            inVarGlobalsContext = true;
         :}
     lista_decl_var
         {:
            inVarGlobalsContext = false;
            RESULT = null;
         :}
  | VAR error
         {:
            inVarGlobalsContext = true;
            addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
                   ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
                   "Seccion VAR mal formada: usa 'id [, id]* : tipo ;'.");
            inVarGlobalsContext = false;
            RESULT = null;
         :}
  | /* vacío */
         {:
            RESULT = null;
         :}
  ;


lista_decl_var
  ::= lista_decl_var decl_var
      {: RESULT = null; :}
  | decl_var
      {: RESULT = null; :}
  ;

decl_var
  ::= ID:id COLON tipo:t SEMI
     {: 
         String nombre = id;
         String tipoVar = t;

         if (!tabla.insertar(nombre, tipoVar)) {
             addErrSemantico(idleft, idright, "Variable '" + nombre + "' ya definida."); // AQUI SE USA EL NUEVO MÉTODO
         }
     :}
  | ID:id COMMA lista_ids:rest COLON tipo:t SEMI
     {:
         String tipoVar = t;
         String nombre = id;
         if (!tabla.insertar(nombre, tipoVar)) {
             addErrSemantico(idleft, idright, "Variable '" + nombre + "' ya definida."); // AQUI SE USA EL NUEVO MÉTODO
         }
         for (String nom : rest) {
             if (!tabla.insertar(nom, tipoVar)) {
                 addErrSemantico(idleft, idright, "Variable '" + nom + "' ya definida."); // AQUI SE USA EL NUEVO MÉTODO
             }
         }
     :}
  ;

lista_ids ::= ID:id
     {: 
        java.util.List<String> l = new java.util.ArrayList<>();
        l.add(id);
        RESULT = l;
     :}
   | lista_ids:lst COMMA ID:id
     {:
        lst.add(id);
        RESULT = lst;
     :}
  ;

/* tipos válidos:
   int, char, string, real
*/
tipo
  ::= INT    {: RESULT = "INT";    :}
  | REAL     {: RESULT = "REAL";   :}
  | CHAR     {: RESULT = "CHAR";   :}
  | STRING   {: RESULT = "STRING"; :}
  ;

/*  Lista de funciones  
   FUNCTION / PROCEDURE f (tipo x, tipo y, … ) : TipoRetorno
   BEGIN
      [ declaracion(es) locales tipo VAR ... ]
      [ cuerpo ]
      f := valorRetorno;
   END

   Los PROCEDURE no tienen tipo de retorno ni asignación final
   (o sea no llevan " : TipoRetorno" ni "f := ...;")
   :contentReference[oaicite:4]{index=4}

/* === Funciones/procedimientos opcionales === */
funcs_opt
  ::= lista_func
    | /* vacío */
  ;

lista_func
  ::= lista_func funcion
    | funcion
  ;

/* 
   - FUNCTION con tipo de retorno
   - PROCEDURE sin tipo de retorno
*/
/* ==== Encabezados de FUNCTION / PROCEDURE con recuperación robusta ==== */
funcion
 /* FUNCTION correcto con tipo de retorno */
 ::= FUNCTION ID LPAREN params_formales_opt RPAREN COLON tipo bloque_func
      {: RESULT = null; :}

 /* Error en parámetros pero sí hay ')' y luego ': tipo' */
 | FUNCTION ID:fname LPAREN error RPAREN COLON tipo bloque_func
      {:
        addErr(fnameleft, fnameright,
          "FUNCIÓN '" + fname + "': parámetros mal definidos. Se sincroniza en ')'.");
        RESULT = null;
      :}

 /* Falta ')' antes de ':' del tipo (p.ej., FUNCTION f(INT x : INT ...) */
 | FUNCTION ID:fname LPAREN error COLON tipo bloque_func
      {:
        addErr(fnameleft, fnameright,
          "FUNCIÓN '" + fname + "': falta ')' antes de ':' del tipo de retorno. Se asume ')'.");
        RESULT = null;
      :}

  | FUNCTION ID:fname LPAREN params_formales_opt COLON tipo bloque_func
     {:
       addErr(fnameleft, fnameright,
         "FUNCIÓN '" + fname + "': falta ')' después de la lista de parámetros y antes de ': tipo'. Se asume ')'.");
       RESULT = null;
     :}

 /* Falta ')' y falta ': tipo'; salta directo al bloque (BEGIN) */
 | FUNCTION ID:fname LPAREN error bloque_func
      {:
        addErr(fnameleft, fnameright,
          "FUNCIÓN '" + fname + "': falta ')' y ': tipo' antes del bloque. Se sincroniza en 'BEGIN'.");
        RESULT = null;
      :}

 /* === NUEVAS: se cerró con ')', pero NO hay ': tipo' y viene BEGIN === */

 /* (NUEVA) Parámetros OK, ')' y luego BEGIN (falta ': tipo') */
 | FUNCTION ID:fname LPAREN params_formales_opt RPAREN bloque_func
      {:
        addErr(fnameleft, fnameright,
          "FUNCIÓN '" + fname + "': falta ': tipo' antes del bloque. Se sincroniza en 'BEGIN'.");
        RESULT = null;
      :}

 /* (NUEVA) Parámetros con error, ')', y luego BEGIN (falta ': tipo') */
 | FUNCTION ID:fname LPAREN error RPAREN bloque_func
      {:
        addErr(fnameleft, fnameright,
          "FUNCIÓN '" + fname + "': parámetros mal definidos y falta ': tipo' antes del bloque. Se sincroniza en 'BEGIN'.");
        RESULT = null;
      :}

 /* PROCEDURE correcto (sin tipo de retorno) */
 | PROCEDURE ID LPAREN params_formales_opt RPAREN bloque_func
      {: RESULT = null; :}

 /* Error en parámetros de PROCEDURE pero sí hay ')' */
 | PROCEDURE ID:pfname LPAREN error RPAREN bloque_func
      {:
        addErr(pfnameleft, pfnameright,
          "PROCEDURE '" + pfname + "': parámetros mal formados. Se sincroniza en ')'.");
        RESULT = null;
      :}

 /* Falta ')' en PROCEDURE y salta directo al bloque */
 | PROCEDURE ID:pfname LPAREN error bloque_func
      {:
        addErr(pfnameleft, pfnameright,
          "PROCEDURE '" + pfname + "': falta ')' antes del bloque. Se sincroniza en 'BEGIN'.");
        RESULT = null;
      :}

  /* Recuperación: Parámetros OK, falta ')' antes de BEGIN */
 | PROCEDURE ID:pfname LPAREN params_formales_opt bloque_func
     {:
       addErr(pfnameleft, pfnameright,
         "PROCEDURE '" + pfname + "': falta ')' después de la lista de parámetros y antes de BEGIN.");
       RESULT = null;
     :}
 ;

/* Parámetros formales:
   la especificación indica que "(tipo x, tipo y, …)".
   Eso es [tipo ID] separados por comas. Ej: INT x, REAL y
*/
params_formales_opt
  ::= lista_params_formales
      {: RESULT = null; :}
  | /* vacío */
      {: RESULT = null; :}
  ;

lista_params_formales
  ::= lista_params_formales COMMA param_formal
      {: RESULT = null; :}
  | param_formal
      {: RESULT = null; :}
  ;

/* Parámetros formales mejorados */
param_formal
  ::= tipo ID:id
      {: RESULT = null; :}
  | tipo error
      {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left, 
                ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right, 
                "Falta el identificador después del tipo en parámetro formal"); :}
  ;
/* bloque_func:
   BEGIN
      [declaraciones locales VAR ... ;]
      [sentencias...]
      [opcionalmente "id_funcion := valorRetorno;" si es FUNCTION]
   END
*/

bloque_func
  ::= BEGIN decls_locales_opt lista_sentencias END
      {: RESULT = null; :}
  | BEGIN decls_locales_opt error END
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).right,
               "Cuerpo de funcion/procedimiento mal formado: verifica sentencias y ';'.");
      :}
  ;

/* la asignación de retorno solo aplica a FUNCTION
   f := expr ;
   Puede NO venir (caso de PROCEDURE)
*/
decls_locales_opt
  ::= VAR lista_decl_var %prec DECLS_END
  | /* vacío */
  ;


/*  Bloques BEGIN...END 

   Main del programa:
   BEGIN
     ...sentencias...
   END
*/
bloque_main
  ::= BEGIN decls_locales_opt lista_sentencias END
      {: RESULT = null; :}
  | BEGIN decls_locales_opt error END
      {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).left,
                ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).right,
                "Bloque principal mal formado: verifica declaraciones locales y sentencias con ';'."); :}
  ;

/*  IF, WHILE, FOR */
bloque
  ::= BEGIN lista_sentencias END
      {: RESULT = null; :}

  /* Contenido con errores pero el bloque se cierra correctamente */
  | BEGIN error END
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "Bloque mal formado. Revisa sentencias internas y ';'. Se sincroniza en 'END'.");
        RESULT = null;
      :}

  /* Falta 'END': no usamos EOF en la gramática; dejamos que CUP recupere */
  | BEGIN lista_sentencias error
      {:
        int l = ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).left;
        int c = ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).right;
        addErr(l, c, "Bloque sin cerrar: falta 'END' para el 'BEGIN' correspondiente.");
        RESULT = null;
      :}
  ;

/*  Lista de sentencias 
   Toda sentencia DEBE terminar en ';'
*/
lista_sentencias
  ::= lista_sentencias sentencia
      {: RESULT = null; :}
  | /* vacío */
      {: RESULT = null; :}
  | error SEMI
      {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).left, ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).right, "Se recupero de un error en una sentencia: probablemente falto ';' o la sentencia está mal formada."); :}
  ;

/* sentencia (factorizada por prefijo ID) */
sentencia
  /* ID := expr ; */
  ::= ID:id ASSIGN expresion SEMI
      {: RESULT = null; :}

  /* RECUPERACIÓN: falta ')' antes de ';' en una asignación (p.ej., x := (1 + 2;) */
  | ID:id ASSIGN LPAREN error SEMI
      {:
        addErr(idleft, idright,
          "Asignación a '" + id + "': falta ')' antes de ';'. Se sincroniza en ';'.");
        RESULT = null;
      :}

  /* RECUPERACIÓN: expresión de la derecha mal formada; sincroniza en ';' */
  | ID:id ASSIGN error SEMI
      {:
        addErr(idleft, idright,
          "Asignación a '" + id + "': expresión mal formada. Se sincroniza en ';'.");
        RESULT = null;
      :}

  /* ID(...) ;  (llamada a función/procedimiento) */
  | ID LPAREN parametros_llamada_opt RPAREN SEMI
      {: RESULT = null; :}

  /* --- WRITE(...) ; --- */
  /* Normal: write_stmt ; */
  | write_stmt SEMI
      {: RESULT = null; :}

  /* RECUPERACIÓN: WRITE("Test";  -> falta ')' antes de ';' */
  | WRITE:w LPAREN error SEMI
      {:
        addErr(wleft, wright,
          "WRITE: falta ')' antes de ';'. Se sincroniza en ';'.");
        RESULT = null;
      :}

  /* --- READ(...) ; --- */
  /* Normal: read_stmt ; */
  | read_stmt SEMI
      {: RESULT = null; :}

  /* RECUPERACIÓN: READ(a;  -> falta ')' antes de ';' */
  | READ:r LPAREN error SEMI
      {:
        addErr(rleft, rright,
          "READ: falta ')' antes de ';'. Se sincroniza en ';'.");
        RESULT = null;
      :}

  /* Otras sentencias que no empiezan por ID */
  | if_stmt
      {: RESULT = null; :}
  | while_stmt
      {: RESULT = null; :}
  | for_stmt
      {: RESULT = null; :}
  ;

/*  Asignaciones y llamadas 
   a := expr;
   A := f();
   A := prueba(a,3,x+1);

   READ puede tener 0 o 1 parámetro.
   WRITE tiene >=1 parámetros. :contentReference[oaicite:6]{index=6}
*/
asignacion
  ::= ID:id ASSIGN expresion
      {: RESULT = null; :}
  | ID:id error expresion
      {: addErr(idleft, idright, "Asignacion mal formada a '" + id  + "': falta ':='."); :}
  ;

/* llamada de función/procedimiento como sentencia */
llamada_funcion_stmt
  ::= ID LPAREN parametros_llamada_opt RPAREN
      {: RESULT = null; :}
  | ID:fname LPAREN error RPAREN
      {: addErr(fnameleft, fnameright, "Llamada a '" + fname  + "': argumentos mal formados dentro de '()'."); :}
  ;
/* READ(...) */
read_stmt
  ::= READ LPAREN RPAREN
       {: RESULT = null; :}
  | READ LPAREN ID RPAREN
       {: RESULT = null; :}
  | READ LPAREN error RPAREN
      {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-3)).left, ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-3)).right, "READ: se esperaba 0 o 1 identificador dentro de '()'."); :}
  ;

/* WRITE(...) */
write_stmt
  ::= WRITE LPAREN lista_expresiones RPAREN
      {: RESULT = null; :}
  | WRITE LPAREN error RPAREN
      {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).left, ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).right, "WRITE: lista de expresiones mal formada dentro de '()'."); :}
  ;

/* parámetros reales en la llamada */
parametros_llamada_opt
  ::= lista_expresiones
      {: RESULT = null; :}
  | /* vacío */
      {: RESULT = null; :}
  ;

/* lista_expresiones: expr (, expr)* */
lista_expresiones
  ::= lista_expresiones COMMA expresion
      {: RESULT = null; :}
  | expresion
      {: RESULT = null; :}
  ;

/*  Estructuras de control 

   WHILE condicion DO BEGIN ... END
   FOR id := expr TO expr DO BEGIN ... END
   IF condicion THEN BEGIN ... END [ELSE BEGIN ... END]

   BEGIN y END siempre vienen aunque sea una sola instrucción.
*/

/* ===================== WHILE ===================== */
while_stmt
  ::= WHILE condicion DO bloque
      {: RESULT = null; :}
  | WHILE error DO bloque
      {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-2)).left,
                ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-2)).right,
                "WHILE: condición mal formada antes de 'DO'."); :}
  /* FALTA BEGIN...END después de DO */
  | WHILE condicion DO error SEMI
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "WHILE: falta bloque 'BEGIN ... END' después de 'DO'. Se encontró una sentencia suelta.");
        RESULT = null;
      :}
  | WHILE condicion DO error END
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "WHILE: falta bloque 'BEGIN ... END' después de 'DO'. Se sincroniza en 'END'.");
        RESULT = null;
      :}
  ;

/* ===================== FOR ===================== */
for_stmt
  ::= FOR ID:id ASSIGN expresion TO expresion DO bloque
      {: RESULT = null; :}
  | FOR ID:id ASSIGN expresion TO expresion DO error SEMI
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "FOR: falta bloque 'BEGIN ... END' después de 'DO'. Se encontró una sentencia suelta.");
        RESULT = null;
      :}
  | FOR ID:id ASSIGN expresion TO expresion DO error END
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "FOR: falta bloque 'BEGIN ... END' después de 'DO'. Se sincroniza en 'END'.");
        RESULT = null;
      :}
  ;

/* ===================== IF / ELSE ===================== */
if_stmt
  ::= IF condicion THEN bloque
      {: 
        //if (cond.tipo != null && !cond.tipo.equals("BOOLEAN")) {
        //    addErrSemantico(condleft, condright, 
        //        "Condición del IF debe ser booleana, se encontro: " + cond.tipo);
        //}
        RESULT = null; 
      :}
  | IF condicion THEN bloque ELSE bloque
      {: RESULT = null; :}
  /* FALTA BEGIN...END tras THEN */
  | IF condicion THEN error SEMI
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "IF: falta bloque 'BEGIN ... END' después de 'THEN'. Se encontró una sentencia suelta.");
        RESULT = null;
      :}
  | IF condicion THEN error END
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "IF: falta bloque 'BEGIN ... END' después de 'THEN'. Se sincroniza en 'END'.");
        RESULT = null;
      :}
  /* FALTA BEGIN...END tras ELSE */
  | IF condicion THEN bloque ELSE error SEMI
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "IF: falta bloque 'BEGIN ... END' después de 'ELSE'. Se encontró una sentencia suelta.");
        RESULT = null;
      :}
  | IF condicion THEN bloque ELSE error END
      {:
        addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left,
               ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right,
               "IF: falta bloque 'BEGIN ... END' después de 'ELSE'. Se sincroniza en 'END'.");
        RESULT = null;
      :}
  ;

/*  Expresiones y condiciones 

   La condición de IF / WHILE / FOR solo debe ser booleana,
   pero por simplicidad sintáctica dejamos que 'condicion'
   sea una 'expresion' y confiamos en análisis semántico
   para validar luego. :contentReference[oaicite:8]{index=8}
*/
condicion
  ::= expresion:exp
      {: 
        // Obtener posición de la expresión
        int line = ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).left;
        int col = ((java_cup.runtime.Symbol)CUP$Parser$stack.peek()).right;
        
        // Verifica que la expresión sea booleana
        if (exp != null && exp.tipo != null && !exp.tipo.equals("BOOLEAN")) {
            addErrSemantico(line, col, 
                "Condición debe ser booleana, se encontró: " + exp.tipo);
        }
        RESULT = exp;
      :}
  ;

/* expresion:
   - operaciones aritméticas (+, -, *, /, DIV, MOD, ++, --)
   - relacionales (=, <>, <, <=, >, >=)
   - booleanas (AND, OR, NOT)
   - llamados a función dentro de expresiones
   - literales
   - paréntesis
*/
expresion
  ::= expresion PLUS expresion
      {: RESULT = null; :}
  | expresion MINUS expresion
      {: RESULT = null; :}
  | expresion TIMES expresion
      {: RESULT = null; :}
  | expresion SLASH expresion
      {: RESULT = null; :}
  | expresion DIV expresion
      {: RESULT = null; :}
  | expresion MOD expresion
      {: RESULT = null; :}

  | expresion INC      /* x++ */
      {: RESULT = null; :}
  | expresion DEC      /* x-- */
      {: RESULT = null; :}
  | INC expresion      /* ++x */
      {: RESULT = null; :}
  | DEC expresion      /* --x */
      {: RESULT = null; :}

  | expresion EQ expresion
      {: RESULT = null; :}
  | expresion NEQ expresion
      {: RESULT = null; :}
  | expresion LT expresion
      {: RESULT = null; :}
  | expresion LE expresion
      {: RESULT = null; :}
  | expresion GT expresion
      {: RESULT = null; :}
  | expresion GE expresion
      {: RESULT = null; :}

  | expresion AND expresion
      {: RESULT = null; :}
  | expresion OR expresion
      {: RESULT = null; :}
  | NOT expresion
      {: RESULT = null; :}

  | factor
      {: RESULT = null; :}
  ;

/* factor */
factor
  ::= ID
      {: RESULT = null; :}
  | INT_LIT
      {: RESULT = null; :}
  | REAL_LIT
      {: RESULT = null; :}
  | STRING_LIT
      {: RESULT = null; :}
  | CHAR_LIT
      {: RESULT = null; :}
  | ID LPAREN parametros_llamada_opt RPAREN
      {: RESULT = null; :}
  | LPAREN expresion RPAREN
      {: RESULT = null; :}
    | LPAREN error RPAREN
        {: addErr(((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).left, ((java_cup.runtime.Symbol)CUP$Parser$stack.elementAt(CUP$Parser$top-1)).right, "Expresion entre paréntesis mal formada."); :}
  ;

